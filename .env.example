# agent-team settings. Copy to .env and adjust. The process environment wins over this file.
# Never commit .env: it is in .gitignore.

# ---- the team ------------------------------------------------------------------------------------------------------
# team.json (roles, humans, approvals, routines). Default: the made-up tea shop in examples/tea-shop.
TEAM_CONFIG=examples/tea-shop/team.json
# Where the mailbox (SQLite), attached files, per-agent MCP configs and MEMORY.md live.
TEAM_DATA_DIR=./data
# The folder agents work in (usually your project's repository). Claude Code runs with this as its working directory.
TEAM_WORKDIR=.

# ---- the dispatcher ------------------------------------------------------------------------------------------------
# 1 = never call Claude: a stub reads the inbox and answers, so you can try the loop for free.
TEAM_DRY_RUN=1
TEAM_CLAUDE_BIN=claude
# Claude Code permission mode for unattended runs: default | acceptEdits | plan | bypassPermissions.
# "default" only allows the tools listed per role in team.json (allowed_tools). Use bypassPermissions ONLY inside a
# sandbox (container/VM, its own OS user, no secrets it shouldn't read). See SECURITY.md.
TEAM_PERMISSION_MODE=default
TEAM_PARALLEL=2
TEAM_DAILY_RUNS=40
TEAM_PROACTIVE_DAILY=8
TEAM_RUN_TIMEOUT_MIN=45
# Heartbeat hours (local time). The digest, routines and the retro use their own "at" in team.json.
TEAM_DAY_START=8
TEAM_DAY_END=20
# Claude Code auth for headless runs: `claude setup-token` (subscription) or ANTHROPIC_API_KEY (API). Set it in the
# dispatcher's environment, not here, if other users can read this file.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# ---- the office (3D screen) ----------------------------------------------------------------------------------------
TEAM_OFFICE_HOST=127.0.0.1
TEAM_OFFICE_PORT=8130
# Set a long random token to open it from another machine: http://host:8130/?token=...
TEAM_OFFICE_TOKEN=
TEAM_OFFICE_REQUIRE_TOKEN=0
# Behind an authenticating reverse proxy (e.g. Cloudflare Access): the proxy's IPs, the header with the user's
# e-mail, and who may see it.
TEAM_OFFICE_TRUSTED_PROXIES=
TEAM_OFFICE_EMAIL_HEADER=Cf-Access-Authenticated-User-Email
TEAM_OFFICE_EMAILS=

# ---- optional: GitHub pull requests (needs `gh` logged in) ---------------------------------------------------------
TEAM_GITHUB=0
TEAM_GITHUB_REPO=

# ---- optional: Discord (mirror + bot) ------------------------------------------------------------------------------
TEAM_DISCORD_ENABLED=0
DISCORD_BOT_TOKEN=
TEAM_DISCORD_CHANNEL=
TEAM_DISCORD_WEBHOOK=
# <discord user id>:<human id from team.json>, comma separated
TEAM_DISCORD_USERS=

# ---- optional: e-mail (agents propose, humans approve, the mailer sends) -------------------------------------------
TEAM_MAILER_ENABLED=0
# Long random string. Only the humans and the mailer may read it (not the agents' OS user).
TEAM_APPROVAL_SECRET=
MAILER_FROM=
MAILER_DAILY=25
# e.g. 9-12 to send only in that window (MAILER_TZ, weekdays unless MAILER_WEEKDAYS_ONLY=0); empty = any time
MAILER_WINDOW=
MAILER_TZ=UTC
# Your own site(s), comma separated (e.g. shop.example.com): every link to them in an email must exist (404/410
# rejects the email; a 5xx leaves it approved for the next round), and a "Re:" may only reuse the first email's links.
MAILER_CHECK_HOSTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASSWORD=
